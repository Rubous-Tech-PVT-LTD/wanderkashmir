generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum VendorType {
  HOTEL
  HOMESTAY
  TAXI
  GUIDE
}

enum SubscriptionPlan {
  FREE
  GROWTH
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?   @unique
  password      String?
  role          Role      @default(CUSTOMER)
  isBanned      Boolean   @default(false)
  banReason     String?
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  vendorProfiles VendorProfile[]
  bookings      Booking[]
  reviews       Review[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VendorProfile {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId         String?          @unique
  type             VendorType
  businessName     String
  isApproved        Boolean          @default(false)
  status            String           @default("PENDING")
  rejectionReason   String?
  subscriptionPlan  SubscriptionPlan @default(FREE)
  kycDocuments      String[]         @default([])
  address           String?
  latitude          Float?
  longitude         Float?
  email             String?
  phone             String?
  altContactPerson  String?
  altPhone          String?
  accountHolderName String?
  bankName          String?
  accountNumber     String?
  ifscCode          String?
  
  // Specific KYC Fields
  gstNumber         String?
  panNumber         String?
  tradeLicense      String?
  
  taxiRole            String? // "INDIVIDUAL" or "STAND"
  drivingLicense      String?
  vehicleRegistration String?
  vehicleType         String?
  
  guideLicense      String?
  languages         String?
  experienceYears   Int?
  
  // Relations
  properties       Property[]
  vehicles         Vehicle[]
  drivers          Driver[]
  rateOverrides    TaxiStandRateOverride[]
  guideProfiles    GuideProfile[]
  
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([userId])
  @@index([type, status])
}

model Property {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  isApproved      Boolean       @default(false)
  status          String        @default("PENDING")
  rejectionReason String?
  name            String
  location        String
  latitude        Float?
  longitude       Float?
  description     String?
  pricePerNight   Float
  availableRooms  Int           @default(1)
  totalRooms      Int           @default(1)
  images          String[]      @default([])
  amenities       String[]      @default([])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings        Booking[]
  reviews         Review[]

  @@index([status, isApproved])
  @@index([location])
  @@index([vendorProfileId])
}

model Vehicle {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  isApproved      Boolean       @default(false)
  status          String        @default("PENDING")
  rejectionReason String?
  make            String
  model           String
  registrationNum String
  type            String        // e.g., Sedan, SUV
  
  capacity               Int           @default(4)
  images                 String[]      @default([])
  platformCommissionRate Float         @default(10) 
  isCommissionPercentage Boolean       @default(true)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings        Booking[]
  reviews         Review[]
}

model Driver {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  
  name            String
  phone           String
  drivingLicense  String
  status          String        @default("ACTIVE") // ACTIVE, INACTIVE
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings        Booking[]
}

model TaxiStandRateOverride {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  
  routePlace      String        // Matches TaxiRateCard.place
  customPrice     Float
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  @@unique([vendorProfileId, routePlace])
}

model TaxiRateCard {
  id        String   @id @default(cuid())
  place     String   // e.g., "LOCAL PAHALGAM FULL DAY", "SRINAGAR TRC DROP"
  rates     Json     // Stores rates as JSON
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaxiTypeImage {
  id        String   @id @default(cuid())
  type      String   @unique // e.g., "CRYSTA", "INNOVA"
  imageUrl  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuideProfile {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  isApproved      Boolean       @default(false)
  status          String        @default("PENDING")
  rejectionReason String?
  
  languages       String[]      @default([])
  experienceYears Int           @default(0)
  pricePerDay     Float         @default(0)
  bio             String?       @db.Text
  specialties     String[]      @default([])
  images          String[]      @default([])
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bookings        Booking[]
  reviews         Review[]
}

model Booking {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  status          String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  
  // Payment Breakdown
  baseAmount      Float     @default(0) // Hotel/Primary amount
  taxiAmount      Float     @default(0) // Taxi add-on amount
  guideAmount     Float     @default(0) // Guide add-on amount
  
  // Payout Statuses
  hotelPayoutStatus String  @default("PENDING") // PENDING, PAID
  taxiPayoutStatus  String  @default("PENDING") // PENDING, PAID
  guidePayoutStatus String  @default("PENDING") // PENDING, PAID
  
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  
  checkIn         DateTime?
  checkOut        DateTime?
  guests          Int?

  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  guideProfileId  String?
  guideProfile    GuideProfile? @relation(fields: [guideProfileId], references: [id], onDelete: SetNull)

  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)
  standApprovalStatus String    @default("PENDING") // PENDING, APPROVED, REJECTED

  tourId          String?
  tour            Tour?     @relation(fields: [tourId], references: [id], onDelete: SetNull)

  razorpayOrderId String?   @unique
  razorpayPaymentId String? @unique

  guestName       String?
  guestPhone      String?
  specialRequests String?
  otherGuests     Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  reviews   Review[]

  @@index([propertyId, status])
  @@index([userId])
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rating          Int      // 1 to 5
  comment         String?  @db.Text
  
  propertyId      String?
  property        Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  guideProfileId  String?
  guideProfile    GuideProfile? @relation(fields: [guideProfileId], references: [id], onDelete: Cascade)
  
  tourId          String?
  tour            Tour?     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Tour {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  duration        String
  destinations    String[] @default([])
  price           Float
  originalPrice   Float?
  category        String
  inclusions      String[] @default([])
  maxPersons      Int
  badge           String?
  images          String[] @default([])
  overview        String?  @db.Text
  highlights      String[] @default([])
  itinerary       Json?
  exclusions      String[] @default([])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  bookings        Booking[]
  reviews         Review[]
}
